# ============================================================
# RAG Chatbot - Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here

# LLM model identifier (configurable; default shown)
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash, gemini-2.5-flash
GEMINI_LLM_MODEL=gemini-2.0-flash

# Embedding model identifier
# Options: models/gemini-embedding-001, models/text-embedding-004
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Embedding vector dimensions (must match the model above)
EMBEDDING_DIMENSIONS=768

# ------------------------------------------------------------
# PostgreSQL (with pgvector)
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me-in-dot-env

# Async connection URL (auto-constructed from above in code, but can be overridden)
# DATABASE_URL=postgresql+asyncpg://rag_user:password@localhost:5432/rag_chatbot

# ------------------------------------------------------------
# Langfuse Observability (optional for local dev)
# Set LANGFUSE_ENABLED=false to disable tracing entirely
# ------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ------------------------------------------------------------
# API Security
# ------------------------------------------------------------
# Simple API key for X-API-Key header authentication (Option B)
# Generate a strong random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-strong-random-value

# ------------------------------------------------------------
# File Upload Limits
# ------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=10
ALLOWED_EXTENSIONS=xlsx,xls,csv,ppt,pptx

# ------------------------------------------------------------
# RAG Configuration
# ------------------------------------------------------------
RETRIEVAL_TOP_K=5
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
